<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Document</title>
</head>

<body>
  <a href="/">Home Page</a>
  <a href="/fruits">Browse Fruits</a>
  <a href="/fruits/new">Add New Fruit</a>
  <h1>All Fruits</h1>
  <ul>
    <% fruits.forEach((fruit)=>{  %>
    <a href="/fruits/<%= fruit._id %>" class="">

      <li> <%= fruit.name %> </li>
    </a>
    <%  }) %>
  </ul>
</body>

</html>