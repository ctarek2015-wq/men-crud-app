<!-- views/fruits/new.ejs -->

<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="stylesheet" href="/stylesheets/style.css" />

  <title>Create a Fruit</title>
</head>

<body>
  <div class="nav">
    <a href="/" class="fruits-index-link">
      <div class="fruits-link-text">Home Page</div>
    </a>
    <a href="/fruits/<%=fruit._id%>" class="fruits-index-link">
      <div class="fruits-link-text">back to <%=fruit.name%></div>
    </a>
    <a href="/fruits/new" class="fruits-index-link">
      <div class="fruits-link-text">Add New Fruit</div>
    </a>

  </div>


  <h1>Editing <%=fruit.name%></h1>

  <form action="/fruits/<%=fruit._id%>?_method=PUT" method="POST">
    <label for="name">Name:</label>
    <input type="text" value="<%= fruit.name %>" name="name" id="name" required />

    <div class="checkbox-div">
      <label for="isReadyToEat">Ready to Eat?</label>
      <input type="checkbox" <%if(fruit.isReadyToEat){%>checked<%}%>   name="isReadyToEat" id="isReadyToEat" />
    </div>

    <button type="submit">Add Fruit</button>
  </form>
</body>

</html>