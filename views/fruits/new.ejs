<!-- views/fruits/new.ejs -->

<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Create a Fruit</title>
  <link rel="stylesheet" href="/stylesheets/style.css" />

</head>

<body>
  <div class="nav">

    <a href="/" class="fruits-index-link">
      <div class="fruits-link-text">Home Page</div>
    </a>
    <a href="/fruits" class="fruits-index-link">
      <div class="fruits-link-text">Browse Fruits</div>
    </a>
    <a href="/fruits/new" class="fruits-index-link">
      <div class="fruits-link-text">Add New Fruit</div>
    </a>
  </div>


  <h1>Create a New Fruit!</h1>
  <form action="/fruits" method="POST">
    <label for="name">Name:</label>
    <input type="text" name="name" id="name" required />

    <div class="checkbox-div">
      <label for="isReadyToEat">Ready to Eat?</label>
      <input type="checkbox" name="isReadyToEat" id="isReadyToEat" />
    </div>
    <button type="submit">Add Fruit</button>
  </form>
</body>

</html>